#!/usr/bin/env bash

set -o pipefail

usage() {
    echo "Usage: ai-status [--once]"
    echo "  --once    Show usage once and exit"
}

# Live mode is the default. watch redraws the same screen every 5 minutes.
if [[ $# -eq 0 ]]; then
    exec env AI_STATUS_COLOR=1 watch -c -n 300 -t -x -- "$0" --once
fi

if [[ $# -ne 1 || "$1" != "--once" ]]; then
    usage
    exit 1
fi

LABEL_WIDTH=17
BAR_WIDTH=24

# Colour when writing to a terminal or when watch (which reads a pipe) asked for it.
if [[ -t 1 || -n "${AI_STATUS_COLOR:-}" ]] && [[ -z "${NO_COLOR:-}" ]]; then
    RESET=$'\e[0m' BOLD=$'\e[1m' DIM=$'\e[2m'
    GREEN=$'\e[32m' AMBER=$'\e[33m' RED=$'\e[31m'
else
    RESET='' BOLD='' DIM='' GREEN='' AMBER='' RED=''
fi

# Percent used → colour: comfortable, getting close, nearly out.
tone() {
    if (($1 < 50)); then printf '%s' "$GREEN"
    elif (($1 < 80)); then printf '%s' "$AMBER"
    else printf '%s' "$RED"
    fi
}

# Seconds from now until an epoch → "5d 2h", "1h 48m", "12m".
time_until() {
    local secs=$(($1 - $(date +%s)))
    ((secs < 0)) && secs=0
    local d=$((secs / 86400)) h=$((secs % 86400 / 3600)) m=$((secs % 3600 / 60))
    if ((d > 0)); then printf '%dd %dh' "$d" "$h"
    elif ((h > 0)); then printf '%dh %dm' "$h" "$m"
    else printf '%dm' "$m"
    fi
}

# One limit window: label, coloured bar, percent, reset time, time until reset.
render_row() {
    local label="$1" percent="$2" epoch="$3"
    local filled_cells filled empty label_pad colour when until

    filled_cells=$(((percent * BAR_WIDTH + 50) / 100))
    printf -v filled '%*s' "$filled_cells" ''
    printf -v empty '%*s' "$((BAR_WIDTH - filled_cells))" ''
    filled=${filled// /━}
    empty=${empty// /─}
    # bash printf pads by bytes, so "·" would shift the bar; pad by characters instead.
    printf -v label_pad '%*s' "$((LABEL_WIDTH - ${#label}))" ''

    colour=$(tone "$percent")
    if [[ "$epoch" =~ ^[0-9]+$ ]]; then
        when=$(date -d "@$epoch" +'%a %H:%M')
        until="  ${DIM}in $(time_until "$epoch")${RESET}"
    else
        when="$epoch"
        until=''
    fi

    printf '  %s%s %s%s%s%s%s  %s%3d%%%s   %s%s\n' \
        "$label" "$label_pad" \
        "$colour" "$filled" "$DIM" "$empty" "$RESET" \
        "$BOLD$colour" "$percent" "$RESET" \
        "$when" "$until"
}

# A titled block. Rows arrive as TSV on stdin: label, percent, reset epoch.
# A row whose label is "note" is printed as a dim footnote instead of a bar.
render_section() {
    local title="$1"
    local label percent epoch

    printf '  %s%s%s\n' "$BOLD" "$title" "$RESET"
    while IFS=$'\t' read -r label percent epoch; do
        if [[ "$label" == "note" ]]; then
            printf '  %s%s%s\n' "$DIM" "$percent" "$RESET"
        elif [[ -n "$label" ]]; then
            render_row "$label" "$percent" "$epoch"
        fi
    done
    printf '\n'
}

# "Sep 15, 9:30pm (Asia/Kolkata)" → epoch. Claude omits the year, so a reset that
# lands past New Year parses into the past; bump it a year when that happens.
claude_epoch() {
    local raw="$1" epoch
    raw=${raw%% (*}
    raw=${raw//,/}
    epoch=$(date -d "$raw" +%s 2>/dev/null) || { printf '%s' "$1"; return; }
    ((epoch < $(date +%s) - 86400)) && epoch=$(date -d "$raw +1 year" +%s)
    printf '%s' "$epoch"
}

# Emits one TSV row per Claude limit window.
fetch_claude() {
    local line label percent resets
    local limit='^Current (session|week.*): ([0-9]+)% used · resets (.+)$'

    claude -p "/usage" |
        while IFS= read -r line; do
            [[ "$line" =~ $limit ]] || continue
            label="${BASH_REMATCH[1]}"
            percent="${BASH_REMATCH[2]}"
            resets="${BASH_REMATCH[3]}"

            if [[ "$label" == "session" ]]; then
                label="Session"
            elif [[ "$label" =~ ^week\ \((.*)\)$ ]]; then
                label="Week · ${BASH_REMATCH[1]}"
            fi

            printf '%s\t%s\t%s\n' "$label" "$percent" "$(claude_epoch "$resets")"
        done
}

# Emits one TSV row per Codex limit window, via the app-server JSON-RPC API.
fetch_codex() {
    local line

    coproc CODEX { codex app-server 2>/dev/null; }
    trap '[ -n "${CODEX_PID:-}" ] && kill "$CODEX_PID" 2>/dev/null' EXIT

    send() {
        printf '%s\n' "$1" >&"${CODEX[1]}"
    }

    send '{"method":"initialize","id":1,"params":{"clientInfo":{"name":"ai-status","version":"1.0"}}}'
    while IFS= read -r -u "${CODEX[0]}" line; do
        jq -e '.id == 1' >/dev/null 2>&1 <<<"$line" && break
    done

    send '{"method":"initialized"}'
    send '{"method":"account/rateLimits/read","id":2}'

    while IFS= read -r -u "${CODEX[0]}" line; do
        jq -e '.id == 2' >/dev/null 2>&1 <<<"$line" || continue
        jq -r '
          (.result.rateLimitsByLimitId.codex // .result.rateLimits) as $r |
          [$r.primary, $r.secondary]
          | map(select(. != null))
          | .[]
          | [
              (if .windowDurationMins == 300 then "5h"
               elif .windowDurationMins == 10080 then "Weekly"
               else "\(.windowDurationMins)m" end),
              (.usedPercent | tostring),
              (.resetsAt // "unknown" | tostring)
            ]
          | @tsv
        ' <<<"$line"
        break
    done
}

# Emits one TSV row per Cursor plan category. The CLI only exposes usage through the
# interactive /usage panel, so drive it inside a throwaway tmux session and read the pane.
fetch_cursor() {
    local session="$CURSOR_SESSION" pane line label percent resets tries

    trap 'tmux -L ai-status kill-session -t "$session" 2>/dev/null' EXIT

    tmux -L ai-status new-session -d -s "$session" -x 100 -y 40 -c "$WORK" 'cursor-agent --trust' || return
    sleep 6
    tmux -L ai-status send-keys -t "$session" '/usage'
    sleep 2
    tmux -L ai-status send-keys -t "$session" Enter

    for ((tries = 0; tries < 30; tries++)); do
        sleep 1
        # $$ is still the main script here; if it was SIGKILLed, nobody else will tidy up.
        kill -0 "$$" 2>/dev/null || { rm -rf "$WORK"; return; }
        pane=$(tmux -L ai-status capture-pane -t "$session" -p 2>/dev/null) || return
        [[ "$pane" == *"Usage • "* ]] && break
    done
    [[ "$pane" == *"Usage • "* ]] || return

    resets=$(sed -nE 's/.*Resets ([A-Za-z]+ [0-9]+).*/\1/p' <<<"$pane" | head -1)
    while IFS= read -r line; do
        if [[ "$line" =~ ^\ *(Included|Auto|API)\ +([0-9]+)%\ used ]]; then
            label="${BASH_REMATCH[1]}"
            percent="${BASH_REMATCH[2]}"
            printf '%s\t%s\t%s\n' "$label" "$percent" "${resets:-unknown}"
        elif [[ "$line" =~ ^\ *On-demand\ usage\ is\ (on|off) ]]; then
            printf 'note\ton-demand usage %s\n' "${BASH_REMATCH[1]}"
        fi
    done <<<"$pane"
}

# Everything a run creates lives under one temp dir and one named tmux session, so
# cleanup is the same whether the run finishes, is interrupted, or is killed.
WORK=$(mktemp -d -t "ai-status.$$.XXXXXX")
CURSOR_SESSION="ai-status-$$"

cleanup() {
    # A second signal mid-cleanup (watch dying sends HUP right after INT) must not cut this short.
    trap '' HUP INT TERM
    tmux -L ai-status kill-session -t "$CURSOR_SESSION" 2>/dev/null
    kill $(jobs -p) 2>/dev/null
    rm -rf "$WORK"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# A SIGKILLed run can't clean up; its session and work dir carry its pid, so reap them here.
while IFS= read -r stale; do
    [[ "$stale" =~ ^ai-status-([0-9]+)$ ]] || continue
    kill -0 "${BASH_REMATCH[1]}" 2>/dev/null || tmux -L ai-status kill-session -t "$stale" 2>/dev/null
done < <(tmux -L ai-status list-sessions -F '#S' 2>/dev/null)
for stale in "${TMPDIR:-/tmp}"/ai-status.*.*; do
    [[ "$stale" =~ /ai-status\.([0-9]+)\.[^/]+$ ]] || continue
    kill -0 "${BASH_REMATCH[1]}" 2>/dev/null || rm -rf "$stale"
done

# Each fetch takes a few seconds, so run them side by side and print once all are in.
fetch_claude >"$WORK/claude" &
fetch_codex >"$WORK/codex" &
fetch_cursor >"$WORK/cursor" &
wait

printf '\n  %sAI usage%s   %supdated %s%s\n\n' "$BOLD" "$RESET" "$DIM" "$(date +'%a %H:%M')" "$RESET"
render_section 'Claude' <"$WORK/claude"
render_section 'Codex' <"$WORK/codex"
render_section 'Cursor' <"$WORK/cursor"
