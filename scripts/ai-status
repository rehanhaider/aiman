#!/usr/bin/env bash
# ai-status: Claude, Codex and Cursor usage limits in one screen.
# Portable: Linux and macOS, bash 3.2+. Needs curl and jq; each section is
# skipped with a note when its CLI isn't installed.

set -o pipefail

usage() {
    echo "Usage: ai-status [--once]"
    echo "  --once    Show usage once and exit"
}

REFRESH_SECONDS=300

# Live mode is the default: redraw the same screen every 5 minutes.
if [[ $# -eq 0 ]]; then
    restore() { printf '\e[?25h'; }
    trap 'restore; exit 0' INT TERM HUP
    trap restore EXIT
    printf '\e[?25l\e[H\e[2J\n  Loading AI usage…\n'
    while :; do
        screen=$(AI_STATUS_COLOR=1 "$0" --once)
        printf '\e[H\e[2J%s\n' "$screen"
        sleep "$REFRESH_SECONDS"
    done
fi

if [[ $# -ne 1 || "$1" != "--once" ]]; then
    usage
    exit 1
fi

LABEL_WIDTH=17
BAR_WIDTH=24

# Colour when writing to a terminal or when live mode (which captures output) asked for it.
if [[ -t 1 || -n "${AI_STATUS_COLOR:-}" ]] && [[ -z "${NO_COLOR:-}" ]]; then
    RESET=$'\e[0m' BOLD=$'\e[1m' DIM=$'\e[2m'
    GREEN=$'\e[32m' AMBER=$'\e[33m' RED=$'\e[31m'
else
    RESET='' BOLD='' DIM='' GREEN='' AMBER='' RED=''
fi

# --- Portable date helpers (GNU date on Linux, BSD date on macOS) -------------

if date -d @0 +%s >/dev/null 2>&1; then DATE_FLAVOR=gnu; else DATE_FLAVOR=bsd; fi

# fmt_epoch EPOCH FORMAT
fmt_epoch() {
    if [[ $DATE_FLAVOR == gnu ]]; then date -d "@$1" +"$2"; else date -r "$1" +"$2"; fi
}

# to_epoch "YYYY-MM-DD HH:MM" [TIMEZONE]
to_epoch() {
    local tz="${2:-${TZ:-}}"
    if [[ $DATE_FLAVOR == gnu ]]; then
        TZ="$tz" date -d "$1" +%s 2>/dev/null
    else
        TZ="$tz" date -j -f '%Y-%m-%d %H:%M' "$1" +%s 2>/dev/null
    fi
}

# --- Rendering ---------------------------------------------------------------

# Percent used → colour: comfortable, getting close, nearly out.
tone() {
    if (($1 < 50)); then printf '%s' "$GREEN"
    elif (($1 < 80)); then printf '%s' "$AMBER"
    else printf '%s' "$RED"
    fi
}

# Seconds from now until an epoch → "5d 2h", "1h 48m", "12m".
time_until() {
    local secs=$(($1 - $(date +%s)))
    ((secs < 0)) && secs=0
    local d=$((secs / 86400)) h=$((secs % 86400 / 3600)) m=$((secs % 3600 / 60))
    if ((d > 0)); then printf '%dd %dh' "$d" "$h"
    elif ((h > 0)); then printf '%dh %dm' "$h" "$m"
    else printf '%dm' "$m"
    fi
}

# One limit window: label, coloured bar, percent, reset time, time until reset.
render_row() {
    local label="$1" percent="$2" epoch="$3"
    local filled_cells filled empty label_pad colour when until

    filled_cells=$(((percent * BAR_WIDTH + 50) / 100))
    ((filled_cells > BAR_WIDTH)) && filled_cells=$BAR_WIDTH
    printf -v filled '%*s' "$filled_cells" ''
    printf -v empty '%*s' "$((BAR_WIDTH - filled_cells))" ''
    filled=${filled// /━}
    empty=${empty// /─}
    # printf pads by bytes, so "·" would shift the bar; pad by characters instead.
    printf -v label_pad '%*s' "$((LABEL_WIDTH - ${#label}))" ''

    colour=$(tone "$percent")
    if [[ "$epoch" =~ ^[0-9]+$ ]]; then
        when=$(fmt_epoch "$epoch" '%a %H:%M')
        until="  ${DIM}in $(time_until "$epoch")${RESET}"
    else
        when="$epoch"
        until=''
    fi

    printf '  %s%s %s%s%s%s%s  %s%3d%%%s   %s%s\n' \
        "$label" "$label_pad" \
        "$colour" "$filled" "$DIM" "$empty" "$RESET" \
        "$BOLD$colour" "$percent" "$RESET" \
        "$when" "$until"
}

# A titled block. Rows arrive as TSV on stdin: label, percent, reset epoch.
# A row whose label is "note" is printed as a dim footnote instead of a bar.
render_section() {
    local title="$1"
    local label percent epoch rows=0

    printf '  %s%s%s\n' "$BOLD" "$title" "$RESET"
    while IFS=$'\t' read -r label percent epoch; do
        if [[ "$label" == "note" ]]; then
            printf '  %s%s%s\n' "$DIM" "$percent" "$RESET"
            rows=$((rows + 1))
        elif [[ -n "$label" && "$percent" =~ ^[0-9]+$ ]]; then
            render_row "$label" "$percent" "$epoch"
            rows=$((rows + 1))
        fi
    done
    ((rows == 0)) && printf '  %sno data%s\n' "$DIM" "$RESET"
    printf '\n'
}

note() {
    printf 'note\t%s\n' "$1"
}

# --- Claude ------------------------------------------------------------------

# Claude reset text → epoch. Handles "Nov 15 at 10:29pm (Asia/Calcutta)",
# "Sep 15, 9:30pm (…)", "3pm (…)". Claude omits the year, so a reset that lands
# past New Year parses into the past; bump it a year when that happens.
claude_epoch() {
    local raw="$1" tz='' rest month='' day='' hour min ampm year now epoch
    local re_tz='^(.*) \(([^)]+)\)$'
    local re_date='^([A-Z][a-z]{2}) ([0-9]{1,2})[, ]+(at )?(.*)$'
    local re_time='^([0-9]{1,2})(:([0-9]{2}))? ?([ap]m)$'

    rest="$raw"
    if [[ "$rest" =~ $re_tz ]]; then
        rest="${BASH_REMATCH[1]}"
        tz="${BASH_REMATCH[2]}"
    fi
    if [[ "$rest" =~ $re_date ]]; then
        month="${BASH_REMATCH[1]}"
        day="${BASH_REMATCH[2]}"
        rest="${BASH_REMATCH[4]}"
    fi
    [[ "$rest" =~ $re_time ]] || { printf '%s' "$raw"; return; }
    hour=$((10#${BASH_REMATCH[1]} % 12))
    min="${BASH_REMATCH[3]:-00}"
    ampm="${BASH_REMATCH[4]}"
    [[ $ampm == pm ]] && hour=$((hour + 12))

    now=$(date +%s)
    year=$(TZ="$tz" date +%Y)
    if [[ -n "$month" ]]; then
        local months=" Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec " prefix
        prefix="${months%% "$month" *}"
        [[ "$prefix" == "$months" ]] && { printf '%s' "$raw"; return; }
        local mm=$(((${#prefix} + 1) / 4 + 1))
        epoch=$(to_epoch "$(printf '%04d-%02d-%02d %02d:%s' "$year" "$mm" "$((10#$day))" "$hour" "$min")" "$tz")
        if [[ -n "$epoch" ]] && ((epoch < now - 86400)); then
            epoch=$(to_epoch "$(printf '%04d-%02d-%02d %02d:%s' "$((year + 1))" "$mm" "$((10#$day))" "$hour" "$min")" "$tz")
        fi
    else
        # Time only: today, or tomorrow if that time has already passed.
        epoch=$(to_epoch "$(TZ="$tz" date +%Y-%m-%d) $(printf '%02d:%s' "$hour" "$min")" "$tz")
        [[ -n "$epoch" ]] && ((epoch < now)) && epoch=$((epoch + 86400))
    fi
    printf '%s' "${epoch:-$raw}"
}

# Emits one TSV row per Claude limit window.
fetch_claude() {
    command -v claude >/dev/null || { note "claude not installed"; return; }
    local line label percent resets
    local limit='^Current (session|week.*): ([0-9]+)% used · resets (.+)$'
    local week='^week \((.*)\)$'

    claude -p "/usage" 2>/dev/null |
        while IFS= read -r line; do
            [[ "$line" =~ $limit ]] || continue
            label="${BASH_REMATCH[1]}"
            percent="${BASH_REMATCH[2]}"
            resets="${BASH_REMATCH[3]}"

            if [[ "$label" == "session" ]]; then
                label="Session"
            elif [[ "$label" =~ $week ]]; then
                label="Week · ${BASH_REMATCH[1]}"
            fi

            printf '%s\t%s\t%s\n' "$label" "$percent" "$(claude_epoch "$resets")"
        done
}

# --- Codex -------------------------------------------------------------------

# Emits one TSV row per Codex limit window, via the app-server JSON-RPC API.
fetch_codex() {
    command -v codex >/dev/null || { note "codex not installed"; return; }
    local in="$WORK/codex.in" out="$WORK/codex.out" pid line

    mkfifo "$in" "$out" || return
    codex app-server <"$in" >"$out" 2>/dev/null &
    pid=$!
    trap 'kill "$pid" 2>/dev/null' EXIT
    trap 'exit 143' TERM
    exec 7>"$in" 8<"$out"

    printf '%s\n' '{"method":"initialize","id":1,"params":{"clientInfo":{"name":"ai-status","version":"1.0"}}}' >&7
    while IFS= read -r -t 20 -u 8 line; do
        jq -e '.id == 1' >/dev/null 2>&1 <<<"$line" && break
    done

    printf '%s\n' '{"method":"initialized"}' '{"method":"account/rateLimits/read","id":2}' >&7

    while IFS= read -r -t 20 -u 8 line; do
        jq -e '.id == 2' >/dev/null 2>&1 <<<"$line" || continue
        jq -r '
          if .error then ["note", "codex: \(.error.message // "request failed")"] | @tsv
          else
            (.result.rateLimitsByLimitId.codex // .result.rateLimits) as $r |
            [$r.primary, $r.secondary]
            | map(select(. != null))
            | .[]
            | [
                (if .windowDurationMins == 300 then "5h"
                 elif .windowDurationMins == 10080 then "Weekly"
                 else "\(.windowDurationMins)m" end),
                (.usedPercent | round | tostring),
                (.resetsAt // "unknown" | tostring)
              ]
            | @tsv
          end
        ' <<<"$line"
        break
    done
    exec 7>&- 8<&-
}

# --- Cursor ------------------------------------------------------------------

# The login cursor-agent saved: macOS Keychain, or auth.json on Linux.
cursor_token() {
    if [[ "$(uname -s)" == Darwin ]]; then
        security find-generic-password -s cursor-access-token -w 2>/dev/null
    else
        jq -r '.accessToken // empty' "${XDG_CONFIG_HOME:-$HOME/.config}/cursor/auth.json" 2>/dev/null
    fi
}

# Emits one TSV row per Cursor plan category, from the same service the
# cursor-agent /usage panel reads.
fetch_cursor() {
    command -v cursor-agent >/dev/null || { note "cursor-agent not installed"; return; }
    local token response
    token=$(cursor_token)
    [[ -n "$token" ]] || { note "not logged in: run cursor-agent login"; return; }

    # Token goes in via stdin so it never shows up in the process list.
    response=$(printf 'Authorization: Bearer %s\n' "$token" |
        curl -sS -m 15 -X POST \
            'https://api2.cursor.sh/aiserver.v1.DashboardService/GetCurrentPeriodUsage' \
            -H @- \
            -H 'Content-Type: application/json' \
            -H 'Connect-Protocol-Version: 1' \
            -d '{}' 2>/dev/null)
    token=''
    [[ -n "$response" ]] || { note "cursor: no response (offline?)"; return; }

    jq -r '
      if .code then
        if .code == "unauthenticated" then ["note", "login expired: open cursor-agent once to refresh it"]
        else ["note", "cursor: \(.message // .code)"] end | @tsv
      elif .planUsage then
        ((.billingCycleEnd | tonumber) / 1000 | floor | tostring) as $reset |
        .planUsage |
        (["Included", (.totalPercentUsed // 0 | round | tostring), $reset],
         ["Auto",     (.autoPercentUsed  // 0 | round | tostring), $reset],
         ["API",      (.apiPercentUsed   // 0 | round | tostring), $reset]) | @tsv
      else ["note", "cursor: unexpected response"] | @tsv
      end
    ' <<<"$response" 2>/dev/null ||
        note "cursor: unreadable response"
}

# --- Main --------------------------------------------------------------------

# Everything a run creates lives under one temp dir, so cleanup is the same
# whether the run finishes, is interrupted, or is killed.
TMP_ROOT="${TMPDIR:-/tmp}"
TMP_ROOT="${TMP_ROOT%/}"
WORK=$(mktemp -d "$TMP_ROOT/ai-status.$$.XXXXXX") || exit 1

cleanup() {
    # A second signal mid-cleanup must not cut this short.
    trap '' HUP INT TERM
    kill $(jobs -p) 2>/dev/null
    wait 2>/dev/null
    rm -rf "$WORK"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# A SIGKILLed run can't clean up; its work dir carries its pid, so reap it here.
for stale in "$TMP_ROOT"/ai-status.*.*; do
    [[ "$stale" =~ /ai-status\.([0-9]+)\.[^/]+$ ]] || continue
    kill -0 "${BASH_REMATCH[1]}" 2>/dev/null || rm -rf "$stale"
done

command -v jq >/dev/null || { echo "ai-status needs jq" >&2; exit 1; }

# Each fetch takes a few seconds, so run them side by side and print once all are in.
fetch_claude >"$WORK/claude" &
fetch_codex >"$WORK/codex" &
fetch_cursor >"$WORK/cursor" &
wait

printf '\n  %sAI usage%s   %supdated %s%s\n\n' "$BOLD" "$RESET" "$DIM" "$(date +'%a %H:%M')" "$RESET"
render_section 'Claude' <"$WORK/claude"
render_section 'Codex' <"$WORK/codex"
render_section 'Cursor' <"$WORK/cursor"
